# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/.next-playwright/
/out/

# production
/build

# misc
.DS_Store
*.pem
# `>nul` redirections in Windows-style commands create a literal file named
# "nul" when run under Git Bash/sh.
nul

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
# Real per-environment files (docker-compose.prod.yml and
# docker-compose.staging.yml read env/.env.production and env/.env.staging).
# Only the *.example templates are committed.
.env.*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma

# PWA build output from the former next-pwa setup. public/sw.js is now a
# hand-written, committed file (web push only), so it is not ignored.
**/public/workbox-*.js
**/public/worker-*.js
**/public/workbox-*.js.map
**/public/worker-*.js.map
logs/

# Runtime data written inside the checkout by the deploy scripts:
# database dumps (scripts/db-backup.sh, customer data) and deployed-tag state.
/backups/
/state/

# build backups
.next_bak*
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
playwright-report/
test-results/
coverage/
docker-compose.override.yml
.pgdata/
package-lock.json

# Production environment for docker-compose.prod.yml. See DEPLOYMENT.md.
#
# Create the real file ON THE SERVER, with fresh secrets and your domain:
#   sh deploy/init-env.sh production app.example.com
# That writes env/.env.production (mode 600). Or copy this file there and
# replace every change_me by hand (openssl rand -hex 32). Never commit it.
#
# This one file is used twice: docker compose reads it for ${...} in
# docker-compose.prod.yml (--env-file), and it is the containers' environment
# (env_file). Keep values on one line, without spaces or "$"; the generated
# secrets are hex, which needs no quoting or URL-encoding.
#
# Every variable the app reads is documented in the root .env.example; only
# the ones a server deployment needs are listed here. NEXT_PUBLIC_* values set
# here reach server code only — the browser bundle is compiled when the image
# is built (DEPLOYMENT.md, "Browser-side settings").

# ── Host ─────────────────────────────────────────────────────────────────────
# Port the app listens on, on 127.0.0.1 only; host nginx proxies to it.
# 3000/3001 are avoided because other apps on a shared host usually hold them.
APP_PORT=3100
# Container memory limits (defaults and reasoning in docker-compose.prod.yml)
# APP_MEM_LIMIT=1g
# POSTGRES_MEM_LIMIT=512m
# REDIS_MEM_LIMIT=256m

# ── Public URL — REQUIRED ────────────────────────────────────────────────────
# The https:// address users open. Absolute links, the default e-mail sender
# (noreply@<host>) and the support address (support@<host>) derive from it.
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXTAUTH_URL=https://app.example.com
# Host that merchant subdomains hang off (<merchant>.app.example.com)
PLATFORM_ROOT_DOMAIN=app.example.com
# Passkeys: the bare host and the origin
WEBAUTHN_RP_ID=app.example.com
WEBAUTHN_ORIGIN=https://app.example.com

# ── Database — REQUIRED ──────────────────────────────────────────────────────
# The postgres container creates this user/database on first start. The
# password in DATABASE_URL must equal POSTGRES_PASSWORD; the host is the
# compose service name "postgres", port 5432 (nothing is published on the host).
POSTGRES_USER=voucher
POSTGRES_PASSWORD=change_me
POSTGRES_DB=voucher
DATABASE_URL=postgresql://voucher:change_me@postgres:5432/voucher?connection_limit=10&pool_timeout=20&connect_timeout=10

# ── Redis — REQUIRED ─────────────────────────────────────────────────────────
# Rate limiting, step-up auth and caching. Format: redis://:<REDIS_PASSWORD>@redis:6379
# (empty user name, then the password). A managed Redis (e.g. Upstash, EU
# region) also works: put its rediss:// URL in REDIS_URL; the bundled container
# still needs REDIS_PASSWORD set.
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@redis:6379

# ── Auth — REQUIRED ──────────────────────────────────────────────────────────
# At least 32 characters; values starting with change_me are rejected at boot.
AUTH_SECRET=change_me
# The app sits behind nginx: trust the Host/X-Forwarded-* headers it sets.
# Without this Auth.js rejects every sign-in in production ("UntrustedHost").
AUTH_TRUST_HOST=true
# Comma-separated e-mails that get platform-admin rights. Empty = no admin.
# Register your own account on the site first, then add its address here:
# sign-up does not verify e-mail ownership, so an address nobody has
# registered yet could be claimed by anyone. deploy.sh rejects example.com.
PLATFORM_ADMIN_EMAILS=
# Never enable test logins in production (leave unset):
# ENABLE_TEST_CREDENTIALS=
# /figma design preview: 404 in production unless "true".
# ENABLE_DESIGN_PREVIEW=

# ── Internal secrets ─────────────────────────────────────────────────────────
# Sent by deploy/run-cron.sh to /api/cron/* (host crontab, see DEPLOYMENT.md)
CRON_SECRET=change_me
# Bearer token for /api/admin/ops/metrics/prometheus. When unset, that
# endpoint is served without authentication.
METRICS_TOKEN=change_me
# Salt for hashing visitor IPs in analytics
IP_SALT=change_me

# ── E-mail (optional — without a provider, mail is not sent) ────────────────
# The sender must be on a domain you have verified in Resend.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@example.com
# RESEND_WEBHOOK_SECRET=whsec_...
# EMAIL_FROM=reports@example.com
# CONTACT_EMAIL=support@example.com
# SMTP fallback:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=noreply@example.com

# ── Payments: Stripe (optional — checkout is disabled without it) ───────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SUBSCRIPTION_PRICE_ID=price_...
# STRIPE_PRICE_ID_STARTER=price_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_SCALE=price_...
# STRIPE_ALLOWED_PRICE_IDS=price_...,price_...
# ALLOWED_CHECKOUT_REDIRECT_HOSTS=app.example.com

# ── Sign-in providers (optional) ─────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# ── Other integrations (optional) ────────────────────────────────────────────
# COMMERCE_WEBHOOK_SECRET=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# AXIOM_TOKEN=
# AXIOM_DATASET=voucher-logs
# Object storage for merchant uploads (Supabase is one option):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

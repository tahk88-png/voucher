# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLATFORM_ROOT_DOMAIN=lvh.me:3000

# Database (matches docker-compose.yml)
# Connection pooling is configured via DATABASE_URL query parameters
POSTGRES_USER=voucher_user
POSTGRES_PASSWORD=voucher_pass
POSTGRES_DB=voucher_db
DATABASE_URL=postgresql://voucher_user:voucher_pass@localhost:5433/voucher_db?connection_limit=20&pool_timeout=20&connect_timeout=10

# Redis (required for production rate limiting and caching)
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=change_me_min_32_chars_long_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Credentials login and legacy test fallback (development)
# Credentials provider validates against User.passwordHash in DB.
# ENABLE_TEST_CREDENTIALS keeps a legacy fallback for local convenience only.
ENABLE_TEST_CREDENTIALS=true
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test123
TEST_ADMIN_EMAIL=admin@coffee-house.com
TEST_ADMIN_PASSWORD=admin123
TEST_STAFF_EMAIL=staff@coffee-house.com
TEST_STAFF_PASSWORD=staff123
TEST_TECH_ADMIN_EMAIL=admin@tech-store.com
TEST_TECH_ADMIN_PASSWORD=techadmin123
TEST_PLATFORM_ADMIN_EMAIL=platform-admin@gifthub.local
TEST_PLATFORM_ADMIN_PASSWORD=platform123
NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=false

# Stripe (optional for development)
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change_me
STRIPE_SUBSCRIPTION_PRICE_ID=price_change_me
STRIPE_PRICE_ID_STARTER=price_starter_change_me
STRIPE_PRICE_ID_PRO=price_pro_change_me
STRIPE_PRICE_ID_SCALE=price_scale_change_me
STRIPE_ALLOWED_PRICE_IDS=price_change_me,price_change_me_too
ALLOWED_CHECKOUT_REDIRECT_HOSTS=example.com

# Resend (optional for development)
RESEND_API_KEY=re_change_me
RESEND_FROM_EMAIL=noreply@vouchr.app

# AI (optional)
OPENAI_API_KEY=sk_change_me
OPENAI_MODEL=gpt-4o-mini
AI_VIBE_LIMIT=5
AI_VIBE_WINDOW_HOURS=24
AI_AGENT_LIMIT=20
AI_AGENT_WINDOW_HOURS=24

# Figma Registry (optional; for pulling design tokens/components via @voucher scope)
FIGMA_REGISTRY_TOKEN=figp_change_me

# SMTP (alternative to Resend, for email magic links)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=change_me
SMTP_FROM=noreply@vouchr.app

# OAuth (optional)
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
APPLE_CLIENT_ID=change_me
APPLE_CLIENT_SECRET=change_me
# Backward-compatible aliases (optional)
APPLE_ID=change_me
APPLE_SECRET=change_me
FACEBOOK_CLIENT_ID=change_me
FACEBOOK_CLIENT_SECRET=change_me
APPLE_TEAM_ID=change_me
APPLE_KEY_ID=change_me
APPLE_PRIVATE_KEY=change_me

# Platform
PLATFORM_ADMIN_EMAILS=platform-admin@gifthub.local,admin@example.com

# Cron
CRON_SECRET=change_me

# Sentry (optional — error tracking & performance monitoring)
# Generate at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://change_me@o0.ingest.sentry.io/0
SENTRY_DSN=https://change_me@o0.ingest.sentry.io/0
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=voucher
SENTRY_AUTH_TOKEN=sntrys_change_me

# Web Push Notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=change_me
VAPID_PRIVATE_KEY=change_me
VAPID_SUBJECT=mailto:admin@vouchr.app

# Supabase (optional — object storage for merchant assets)
NEXT_PUBLIC_SUPABASE_URL=https://change_me.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=change_me
SUPABASE_SERVICE_ROLE_KEY=change_me

# Pusher (optional — real-time notifications)
NEXT_PUBLIC_PUSHER_KEY=change_me
NEXT_PUBLIC_PUSHER_CLUSTER=eu
PUSHER_APP_ID=change_me
PUSHER_SECRET=change_me

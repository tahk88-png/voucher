// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  status        UserStatus @default(active)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  orgMemberships   OrgMembership[]
  merchantMembers  MerchantMember[]
  referrals        Referral[]         @relation("Referrer")
  redemptions      Redemption[]        @relation("RedeemedBy")
  staffRedemptions Redemption[]        @relation("RedeemedByStaff")
  creditLedgers    CreditLedger[]
  creditUsages     CreditUsage[]
  voucherPurchases VoucherPurchase[]
  ticketPurchases  TicketPurchase[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  notificationSubscriptions NotificationSubscription[]
  staffGiftCardRedemptions GiftCard[] @relation("GiftCardRedeemedByStaff")
  cashierRedemptions VoucherRedemption[] @relation("VoucherRedemptionCashier")
  orgAuditEvents     AuditEvent[] @relation("OrgAuditActor")

  @@index([status])
}

enum OrgType {
  buyer
  partner
  platform_owner
}

enum OrgStatus {
  active
  suspended
}

enum UserStatus {
  active
  invited
  disabled
}

enum OrgRole {
  owner
  admin
  finance
  marketing
  support
  partner_cashier
  auditor
}

enum B2BCampaignStatus {
  draft
  active
  paused
  archived
}

enum B2BVoucherStatus {
  created
  issued
  active
  redeemed
  expired
  voided
}

enum VoucherValueType {
  fixed
  percent
}

enum VoucherUsageType {
  single
  multi
}

enum IssuedToType {
  company
  person
}

enum B2BOrderStatus {
  draft
  submitted
  invoiced
  paid
  cancelled
  refunded
}

enum B2BInvoiceStatus {
  issued
  paid
  voided
  overdue
}

enum B2BRedemptionStatus {
  approved
  reversed
  failed
}

enum AuditActorType {
  system
  user
  partner_api
}

enum AuditEntityType {
  voucher
  campaign
  order
  invoice
  org
  user
  redemption
}

enum AuditEventType {
  create
  issue
  activate
  redeem
  expire
  void
  refund
  pause
  resume
  update
  reverse
}

model Organization {
  id            String    @id @default(uuid())
  type          OrgType
  name          String
  registryCode  String?
  vatNumber     String?
  billingEmail  String?
  status        OrgStatus @default(active)
  flagsJson     Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members           OrgMembership[]
  campaigns         VoucherCampaign[]
  vouchers          VoucherInstance[] @relation("VoucherOrg")
  issuedVouchers    VoucherInstance[] @relation("VoucherIssuedOrg")
  orders            B2BOrder[]
  partnerRedemptions VoucherRedemption[] @relation("PartnerOrgRedemptions")
  auditEvents       AuditEvent[]
  apiKeys           PartnerApiKey[]
  partnerCampaignLinks CampaignAllowedPartner[]

  @@index([type])
  @@index([status])
}

model OrgMembership {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  role      OrgRole
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

model VoucherCampaign {
  id                      String            @id @default(uuid())
  orgId                   String
  name                    String
  description             String?
  codePrefix              String?
  valueType               VoucherValueType
  valueAmount             Int
  currency                String            @default("EUR")
  usageType               VoucherUsageType  @default(single)
  maxRedemptionsPerVoucher Int?
  validFrom               DateTime?
  validTo                 DateTime?
  minPurchaseAmount       Int?
  status                  B2BCampaignStatus @default(draft)
  restrictionsJson        Json?             @default("{}")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vouchers  VoucherInstance[]
  orders    B2BOrder[]
  allowedPartners CampaignAllowedPartner[]
  allowedProducts CampaignAllowedProduct[]
  allowedLocations CampaignAllowedLocation[]

  @@index([orgId])
  @@index([status])
  @@index([validFrom, validTo])
}

model VoucherInstance {
  id                  String            @id @default(uuid())
  campaignId          String
  orgId               String
  code                String            @unique
  codeHash            String?           @unique
  qrPayload           String?
  status              B2BVoucherStatus  @default(created)
  issuedToType        IssuedToType?
  issuedToOrgId       String?
  issuedToEmail       String?
  initialValueAmount  Int
  remainingValueAmount Int?
  redeemedCount       Int               @default(0)
  activatedAt         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  org          Organization      @relation("VoucherOrg", fields: [orgId], references: [id], onDelete: Cascade)
  campaign     VoucherCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  issuedToOrg  Organization?     @relation("VoucherIssuedOrg", fields: [issuedToOrgId], references: [id], onDelete: SetNull)
  redemptions  VoucherRedemption[]
  orderLinks   OrderVoucher[]

  @@index([orgId])
  @@index([campaignId])
  @@index([status])
  @@index([codeHash])
}

model CampaignAllowedPartner {
  id          String @id @default(uuid())
  campaignId  String
  partnerOrgId String

  campaign VoucherCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  partner  Organization    @relation(fields: [partnerOrgId], references: [id], onDelete: Cascade)

  @@unique([campaignId, partnerOrgId])
  @@index([partnerOrgId])
}

model CampaignAllowedProduct {
  id          String @id @default(uuid())
  campaignId  String
  productId   String

  campaign VoucherCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([productId])
}

model CampaignAllowedLocation {
  id          String @id @default(uuid())
  campaignId  String
  locationId  String

  campaign VoucherCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, locationId])
  @@index([locationId])
}

model B2BOrder {
  id               String       @id @default(uuid())
  orgId            String
  campaignId       String
  quantity         Int
  unitPriceAmount  Int
  totalAmount      Int
  currency         String       @default("EUR")
  status           B2BOrderStatus @default(draft)
  paymentProvider  String?
  paymentReference String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign  VoucherCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  invoice   B2BInvoice?
  vouchers  OrderVoucher[]

  @@index([orgId])
  @@index([campaignId])
  @@index([status])
}

model B2BInvoice {
  id             String        @id @default(uuid())
  orderId        String        @unique
  invoiceNumber  String
  issuedAt       DateTime
  dueAt          DateTime?
  subtotalAmount Int
  vatAmount      Int
  totalAmount    Int
  status         B2BInvoiceStatus @default(issued)
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order B2BOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([issuedAt])
}

model OrderVoucher {
  orderId   String
  voucherId String

  order   B2BOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  voucher VoucherInstance @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@id([orderId, voucherId])
  @@index([voucherId])
}

model VoucherRedemption {
  id             String              @id @default(uuid())
  voucherId      String
  partnerOrgId   String
  locationId     String?
  cashierUserId  String?
  amountRedeemed Int
  currency       String
  status         B2BRedemptionStatus @default(approved)
  idempotencyKey String
  metadata       Json?
  createdAt      DateTime            @default(now())

  voucher   VoucherInstance @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  partner   Organization    @relation("PartnerOrgRedemptions", fields: [partnerOrgId], references: [id], onDelete: Cascade)
  cashier   User?           @relation("VoucherRedemptionCashier", fields: [cashierUserId], references: [id], onDelete: SetNull)

  @@unique([partnerOrgId, idempotencyKey])
  @@index([voucherId])
  @@index([partnerOrgId])
  @@index([createdAt])
}

model AuditEvent {
  id          String         @id @default(uuid())
  orgId       String
  actorUserId String?
  actorType   AuditActorType @default(user)
  entityType  AuditEntityType
  entityId    String
  eventType   AuditEventType
  before      Json?
  after       Json?
  createdAt   DateTime       @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation("OrgAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model PartnerApiKey {
  id           String   @id @default(uuid())
  orgId        String
  label        String?
  keyHash      String   @unique
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Merchant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  country         String
  defaultCurrency String   @default("USD")
  brandLogoUrl    String?
  brandColorsJson Json?
  website         String?
  supportEmail    String?
  isActive        Boolean  @default(true)  // Kill switch for launch mode
  featureFlags    Json?                    // Per-merchant feature flags
  invitedAt       DateTime?                // Track manual invites
  onboardedAt     DateTime?                 // Track onboarding completion
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members      MerchantMember[]
  vouchers     Voucher[]
  campaigns    Campaign[]
  referrals    Referral[]
  redemptions  Redemption[]
  creditLedgers CreditLedger[]
  creditUsages  CreditUsage[]
  voucherPurchases VoucherPurchase[]
  giftCards       GiftCard[]
  subscription   MerchantSubscription?
  events          Event[]
  tickets         Ticket[]
  ticketPurchases TicketPurchase[]
  auditLogs    AuditLog[]
  notifications    Notification[]
  notificationSubscriptions NotificationSubscription[]
  pageBuilderPages PageBuilderPage[]
  domainMappings DomainMapping[]
  navigationLinks NavigationLink[]
  sitePages SitePage[]
  products Product[]
  rentalItems RentalItem[]
  checkoutIntents CheckoutIntent[]

  @@index([isActive])
}

model MerchantMember {
  id        String   @id @default(cuid())
  merchantId String
  userId    String
  role      String   // merchant_admin | merchant_staff
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([merchantId])
  @@index([userId])
}

model Campaign {
  id              String   @id @default(cuid())
  merchantId      String
  name            String
  description     String?
  type            String   // weekly | limited
  startDate       DateTime
  endDate         DateTime
  price           Int?     // minor units, null = free
  discountRules   Json?    // { type, value, currency }
  maxRedemptions  Int?
  maxPurchases    Int?
  terms           String?
  creditPercentage Int?    // % of purchase price as credit (basis points, e.g. 500 = 5%)
  promotedWeeklyEmail Boolean @default(false) // Paid weekly newsletter visibility
  promotedNotification Boolean @default(false) // Paid notification visibility
  promotedUntil  DateTime? // Optional end date for promotion
  status          String   @default("draft") // draft | active | ended
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  vouchers Voucher[]
  purchases VoucherPurchase[]

  @@index([merchantId])
  @@index([status])
  @@index([startDate, endDate])
}

model Voucher {
  id                String   @id @default(cuid())
  merchantId        String
  campaignId        String?
  status            String   @default("draft") // draft | published | paused | ended
  type              String   // percentage | fixed_amount | credit_amount
  value             Int      // minor units for money, basis points for percentage
  currency          String
  validFrom         DateTime
  validTo           DateTime
  usageLimitTotal   Int?
  usageLimitPerUser Int?
  weeklyDropEnabled Boolean  @default(false)
  weeklyDropJson    Json?
  conditionsJson    Json?
  designJson        Json?
  codePrefix        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  referrals  Referral[]
  redemptions Redemption[]
  purchases  VoucherPurchase[]

  @@index([merchantId])
  @@index([campaignId])
  @@index([status])
  @@index([validFrom, validTo])
}

model Referral {
  id            String   @id @default(cuid())
  voucherId     String
  merchantId    String
  referrerUserId String
  friendHash    String   // hash of friend identifier (phone/email)
  status        String   @default("created") // created | opened | redeemed | expired | blocked
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  voucher    Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  referrer   User        @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  redemption Redemption?

  @@index([voucherId])
  @@index([merchantId])
  @@index([referrerUserId])
  @@index([friendHash])
  @@index([status])
}

model Redemption {
  id                  String    @id @default(cuid())
  voucherId           String
  merchantId           String
  referralId          String?  @unique
  redeemedByUserId    String?
  redeemedByStaffUserId String?
  method              String    // online | in_store
  location            String?   // optional location for redemption
  orderReference      String?
  amountBeforeDiscount Int      // minor units
  discountApplied     Int       // minor units
  currency            String
  confirmedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  voucher   Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  merchant  Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  referral  Referral?   @relation(fields: [referralId], references: [id], onDelete: SetNull)
  redeemedBy User?      @relation("RedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  redeemedByStaff User? @relation("RedeemedByStaff", fields: [redeemedByStaffUserId], references: [id], onDelete: SetNull)

  @@index([voucherId])
  @@index([merchantId])
  @@index([referralId])
  @@index([confirmedAt])
}

model VoucherPurchase {
  id              String   @id @default(cuid())
  voucherId       String?
  campaignId      String?
  merchantId      String
  userId          String
  stripeSessionId String?
  amount          Int      // minor units
  currency        String
  status          String   @default("pending") // pending | paid | failed | refunded
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  voucher  Voucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([userId])
  @@index([status])
  @@index([stripeSessionId])
}

model CreditLedger {
  id        String   @id @default(cuid())
  merchantId String
  userId    String
  amount    Int      // minor units
  currency  String
  status    String   @default("locked") // locked | available | used | expired | reversed
  source    String   // referral_redemption | manual_adjustment
  sourceId  String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model CreditUsage {
  id              String   @id @default(cuid())
  merchantId      String
  userId          String
  creditLedgerIds String[] // array of credit ledger IDs used
  amountUsed      Int      // minor units
  orderReference  String?
  createdAt       DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([userId])
}

model Event {
  id              String   @id @default(cuid())
  merchantId      String
  name            String
  description     String?
  type            String   // festival | internal | concert | workshop | other
  eventDate       DateTime
  eventEndDate    DateTime?
  location        String?
  locationAddress String?
  maxCapacity     Int      // Maximum number of tickets/seats
  price           Int       // minor units, 0 = free
  currency        String    @default("USD")
  ticketTypesJson Json?     // [{ name, price, capacity }] for different ticket tiers
  terms           String?
  status          String    @default("draft") // draft | published | sold_out | cancelled | ended
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tickets  Ticket[]
  purchases TicketPurchase[]

  @@index([merchantId])
  @@index([status])
  @@index([eventDate])
}

model Ticket {
  id                String   @id @default(cuid())
  eventId           String
  merchantId        String
  ticketType        String?  // VIP, Standard, Early Bird, etc.
  ticketNumber      String   @unique // Human-readable ticket number
  qrToken           String   @unique // QR code token
  status            String   @default("available") // available | sold | used | cancelled | refunded
  purchasedAt       DateTime?
  usedAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  purchase TicketPurchase?

  @@index([eventId])
  @@index([merchantId])
  @@index([status])
  @@index([qrToken])
  @@index([ticketNumber])
}

model TicketPurchase {
  id              String   @id @default(cuid())
  ticketId        String   @unique
  eventId         String
  merchantId      String
  userId          String
  stripeSessionId String?
  amount          Int      // minor units
  currency        String
  status          String   @default("pending") // pending | paid | failed | refunded
  attendeeName    String?  // Name of attendee (may differ from user)
  attendeeEmail   String?  // Email of attendee
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket  Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event  Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([stripeSessionId])
}

model GiftCard {
  id                  String   @id @default(cuid())
  merchantId          String
  code                String   @unique
  amount              Int      // minor units
  currency            String
  status              String   @default("active") // active | redeemed | expired | cancelled
  validFrom           DateTime @default(now())
  validTo             DateTime?
  designJson          Json?
  message             String?
  imageUrl            String?
  logoUrl             String?
  redeemedAt          DateTime?
  redeemedByStaffUserId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  redeemedByStaff User? @relation("GiftCardRedeemedByStaff", fields: [redeemedByStaffUserId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([status])
  @@index([validTo])
  @@index([redeemedAt])
}

model MerchantSubscription {
  id                   String   @id @default(cuid())
  merchantId           String   @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  priceId              String?
  status               String   @default("inactive") // inactive | trialing | active | past_due | canceled
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  merchantId  String?
  actorUserId String
  action      String
  payloadJson Json?
  createdAt   DateTime @default(now())

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  actor    User      @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  merchantId String?
  type       String
  title      String
  body       String
  url        String?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([merchantId])
  @@index([readAt])
  @@index([createdAt])
}

model NotificationSubscription {
  id           String   @id @default(cuid())
  userId       String
  merchantId   String
  emailEnabled Boolean  @default(true)
  inAppEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([merchantId])
}

model PageBuilderPage {
  id          String   @id @default(cuid())
  merchantId  String
  type        String   // store | rental
  status      String   @default("draft") // draft | published
  title       String
  subtitle    String?
  sectionsJson Json?
  addonsJson   Json?
  themeJson    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, type])
  @@index([merchantId])
  @@index([type])
}

model SitePage {
  id          String   @id @default(cuid())
  merchantId  String?
  scope       String   @default("tenant") // tenant | hub
  slug        String
  title       String
  description String?
  status      String   @default("draft") // draft | published
  blocksJson  Json?
  seoJson     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, scope, slug])
  @@index([merchantId])
  @@index([scope])
  @@index([slug])
}

model NavigationLink {
  id         String   @id @default(cuid())
  merchantId String?
  scope      String   @default("tenant") // tenant | hub
  label      String
  href       String
  position   String   @default("header") // header | footer
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([scope])
  @@index([position])
}

model DomainMapping {
  id                String   @id @default(cuid())
  merchantId        String
  domain            String   @unique
  status            String   @default("pending") // pending | verified
  verificationToken String?
  verifiedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([status])
}

model Product {
  id          String   @id @default(cuid())
  merchantId  String
  name        String
  description String?
  price       Int
  currency    String
  imageUrl    String?
  tags        Json?
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([status])
}

model RentalItem {
  id           String   @id @default(cuid())
  merchantId   String
  name         String
  description  String?
  dailyRate    Int
  weeklyRate   Int?
  currency     String
  imageUrl     String?
  status       String   @default("active") // active | archived
  minDays      Int?    @default(1)
  availableFrom DateTime?
  availableTo   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)


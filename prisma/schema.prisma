model VatRate {
  id             String    @id @default(cuid())
  countryCode    String // ISO 3166-1 alpha-2 (e.g., "DE", "FR")
  rate           Float // VAT rate as percentage (e.g., 19.0)
  rateType       String // "standard" | "reduced" | "super_reduced" | "zero"
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([countryCode, rateType, effectiveFrom])
  @@index([countryCode])
  @@index([isActive])
}

model VatExemption {
  id                String    @id @default(cuid())
  merchantId        String
  countryCode       String
  exemptionType     String // "b2b" | "export" | "charity" | "public_body"
  documentReference String? // Reference to supporting document
  approvedAt        DateTime?
  approvedBy        String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  merchant Merchant @relation("VatExemptionMerchant", fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, countryCode, exemptionType])
  @@index([merchantId])
}

model Invoice {
  id            String @id @default(cuid())
  merchantId    String
  invoiceNumber String @unique
  status        String @default("issued") // "issued" | "paid" | "voided" | "overdue"

  // Amounts in minor units (cents)
  grossAmount Int // Total including VAT
  netAmount   Int // Before VAT
  vatAmount   Int // VAT charged
  vatRate     Float // VAT percentage applied
  vatCountry  String // Country where VAT applies
  currency    String @default("USD")

  issuedAt   DateTime
  dueAt      DateTime?
  paidAt     DateTime?
  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation("InvoiceMerchant", fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([status])
  @@index([issuedAt])
}

model RefundRequest {
  id                String    @id @default(cuid())
  merchantId        String
  originalPaymentId String?
  amount            Int // Amount to refund in minor units
  currency          String
  reason            String
  status            String    @default("pending") // "pending" | "approved" | "rejected" | "executed"
  requestedBy       String // User ID who requested
  approvedBy        String? // User ID who approved
  rejectionReason   String?
  executedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  merchant Merchant @relation("RefundRequestMerchant", fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([status])
}

model PayoutRecord {
  id                String    @id @default(cuid())
  merchantId        String
  settlementBatchId String?
  amount            Int // Amount in minor units
  currency          String
  status            String    @default("pending") // "pending" | "processing" | "completed" | "failed"
  bankAccount       String? // Masked account number
  reference         String? // Payout order ID from payment processor
  failureReason     String?
  scheduledFor      DateTime
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  merchant        Merchant         @relation("PayoutRecordMerchant", fields: [merchantId], references: [id], onDelete: Cascade)
  settlementBatch SettlementBatch? @relation(fields: [settlementBatchId], references: [id])

  @@index([merchantId])
  @@index([status])
  @@index([scheduledFor])
}

model SettlementBatch {
  id            String    @id @default(cuid())
  batchNumber   String    @unique
  status        String    @default("pending") // "pending" | "processing" | "completed" | "failed"
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Int // Total in minor units
  currency      String    @default("USD")
  payoutCount   Int       @default(0)
  processedAt   DateTime?
  failureReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payoutRecords PayoutRecord[]

  @@index([status])
  @@index([periodStart, periodEnd])
}

model DataExportRequest {
  id              String    @id @default(cuid())
  userId          String
  merchantId      String? // If null, request is for user's own data
  status          String    @default("pending") // "pending" | "processing" | "ready" | "expired" | "failed"
  downloadUrl     String? // Temporary signed URL
  downloadExpires DateTime? // URL expiration
  fileSize        Int? // Size in bytes
  errorMessage    String?
  requestedAt     DateTime  @default(now())
  processedAt     DateTime?
  expiresAt       DateTime? // Data deletion deadline (30 days)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User      @relation("DataExportRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant? @relation("DataExportRequestMerchant", fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model DataDeletionRequest {
  id                String    @id @default(cuid())
  userId            String
  merchantId        String?
  status            String    @default("pending") // "pending" | "grace_period" | "executing" | "completed" | "failed"
  reason            String?
  resultSummary     Json? // Summary of deleted data
  requestedAt       DateTime  @default(now())
  gracePeriodEndsAt DateTime // 30-day grace period
  completedAt       DateTime?
  failureReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation("DataDeletionRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant? @relation("DataDeletionRequestMerchant", fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([gracePeriodEndsAt])
}

model UserConsent {
  id          String    @id @default(cuid())
  userId      String
  merchantId  String
  consentType String // "marketing" | "analytics" | "processing" | "profiling"
  granted     Boolean
  grantedAt   DateTime?
  withdrawnAt DateTime?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User     @relation("UserConsentUser", fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant @relation("UserConsentMerchant", fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId, consentType])
  @@index([userId])
  @@index([merchantId])
  @@index([granted])
}

model HealthCheckLog {
  id             String   @id @default(cuid())
  status         String // "healthy" | "degraded" | "unhealthy"
  databaseHealth Boolean  @default(false)
  stripeHealth   Boolean  @default(false)
  redisHealth    Boolean  @default(false)
  emailHealth    Boolean  @default(false)
  message        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

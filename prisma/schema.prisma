  customTitle       String?
  customDescription String?  @db.Text
  priority          Int      @default(0)
  createdAt         DateTime @default(now())

  module  GiftFeedModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  product GiftProduct?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([moduleId, priority])

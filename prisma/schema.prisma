  actorUserId        String
  action             String
  resourceType       String? // "campaign" | "voucher" | "payment" etc.
  resourceId         String? // ID of affected resource
  changes            Json? // { before: {...}, after: {...} }
  payloadJson        Json?
  ipAddress          String?
  userAgent          String?

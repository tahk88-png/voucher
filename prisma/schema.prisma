model CheckoutIntent {
  id         String   @id @default(cuid())
  merchantId String
  type       String   // product | rental
  currency   String
  total      Int
  status     String   @default("created") // created | converted | expired
  itemsJson  Json
  metaJson   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([type])
  @@index([status])

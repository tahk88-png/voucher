// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique @default(cuid())
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  emailVerified     DateTime?
  name              String?
  passwordHash      String?
  status            UserStatus @default(active)
  image             String?
  adminRole         AdminRole?
  preferredLanguage String?    @default("en")
  deleted           Boolean    @default(false)
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  accounts                  Account[]
  sessions                  Session[]
  orgMemberships            OrgMembership[]
  merchantMembers           MerchantMember[]
  referrals                 Referral[]                 @relation("Referrer")
  redemptions               Redemption[]               @relation("RedeemedBy")
  staffRedemptions          Redemption[]               @relation("RedeemedByStaff")
  creditLedgers             CreditLedger[]
  creditUsages              CreditUsage[]
  voucherPurchases          VoucherPurchase[]
  giftCardPurchases         GiftCardPurchase[]
  ticketPurchases           TicketPurchase[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  notificationSubscriptions NotificationSubscription[]
  staffGiftCardRedemptions  GiftCard[]                 @relation("GiftCardRedeemedByStaff")
  cashierRedemptions        VoucherRedemption[]        @relation("VoucherRedemptionCashier")
  orgAuditEvents            AuditEvent[]               @relation("OrgAuditActor")
  pushSubscriptions         PushSubscription[]
  dataExportRequests        DataExportRequest[]        @relation("DataExportRequestUser")
  dataDeletionRequests      DataDeletionRequest[]      @relation("DataDeletionRequestUser")
  userConsents              UserConsent[]              @relation("UserConsentUser")

  // Super Admin Control Wall relations
  adminAuditLogs       AdminAuditLog[]    @relation("AdminAuditActor")
  userReportsBy        UserReport[]       @relation("ReportedByUser")
  userReportsOn        UserReport[]       @relation("ReportedUser")
  moderationActionsBy  ModerationAction[] @relation("ModeratorUser")
  moderationActionsOn  ModerationAction[] @relation("ModeratedUser")
  appeals              Appeal[]           @relation("AppealUser")
  appealReviewsBy      Appeal[]           @relation("AppealReviewer")
  supportCases         SupportCase[]      @relation("SupportCaseUser")
  supportCasesAssigned SupportCase[]      @relation("SupportCaseAssignee")
  supportNotes         SupportNote[]
  refundRecords        RefundRecord[]     @relation("RefundActorUser")
  payoutHolds          PayoutHold[]       @relation("PayoutHoldActorUser")
  legalHolds           LegalHold[]        @relation("LegalHoldActorUser")

  // Smart Gift Feed relations
  giftProfile      UserGiftProfile?      @relation("UserGiftProfileUser")
  giftInteractions UserGiftInteraction[] @relation("UserGiftInteractionUser")

  @@index([status])
  @@index([adminRole])
  @@index([deleted])
  @@index([deletedAt])
}

enum OrgType {
  buyer
  partner
  platform_owner
}

enum OrgStatus {
  active
  suspended
}

enum UserStatus {
  active
  invited
  disabled
}

enum OrgRole {
  owner
  admin
  finance
  marketing
  support
  partner_cashier
  auditor
}

enum B2BCampaignStatus {
  draft
  active
  paused
  archived
}

enum B2BVoucherStatus {
  created
  issued
  active
  redeemed
  expired
  voided
}

enum VoucherValueType {
  fixed
  percent
}

enum VoucherUsageType {
  single
  multi
}

enum IssuedToType {
  company
  person
}

enum B2BOrderStatus {
  draft
  submitted
  invoiced
  paid
  cancelled
  refunded
}

enum B2BInvoiceStatus {
  issued
  paid
  voided
  overdue
}

enum B2BRedemptionStatus {
  approved
  reversed
  failed
}

enum AuditActorType {
  system
  user
  partner_api
}

enum AuditEntityType {
  voucher
  campaign
  order
  invoice
  org
  user
  redemption
}

enum AuditEventType {
  create
  issue
  activate
  redeem
  expire
  void
  refund
  pause
  resume
  update
  reverse
}

// ─── Super Admin Control Wall Enums ───

enum AdminRole {
  super_admin
  ops_admin
  billing_admin
  moderator
  support_admin
}

enum ReportStatus {
  open
  under_review
  resolved
  dismissed
}

enum ReportCategory {
  spam
  fraud
  offensive_content
  trademark_violation
  other
}

enum ModerationActionType {
  warning
  content_removal
  suspension
  ban
  unban
  feature_restriction
}

enum AppealStatus {
  submitted
  under_review
  approved
  denied
  escalated
}

enum SupportCaseStatus {
  open
  in_progress
  waiting_on_user
  resolved
  closed
}

enum SupportCasePriority {
  low
  normal
  high
  urgent
}

enum FeatureFlagStatus {
  off
  percentage
  allowlist
  on
}

enum JobRunStatus {
  pending
  running
  succeeded
  failed
  skipped
}

enum RefundStatus {
  refund_pending
  processing
  refund_succeeded
  refund_failed
  refund_cancelled
}

enum PayoutHoldReason {
  fraud_review
  chargeback
  compliance
  manual
}

enum LegalHoldType {
  gdpr_request
  law_enforcement
  litigation
  regulatory
}

model Organization {
  id           String    @id @default(uuid())
  type         OrgType
  name         String
  registryCode String?
  vatNumber    String?
  billingEmail String?
  status       OrgStatus @default(active)
  flagsJson    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  members              OrgMembership[]
  campaigns            VoucherCampaign[]
  vouchers             VoucherInstance[]        @relation("VoucherOrg")
  issuedVouchers       VoucherInstance[]        @relation("VoucherIssuedOrg")
  orders               B2BOrder[]
  partnerRedemptions   VoucherRedemption[]      @relation("PartnerOrgRedemptions")
  auditEvents          AuditEvent[]
  apiKeys              PartnerApiKey[]
  partnerCampaignLinks CampaignAllowedPartner[]

  @@index([type])
  @@index([status])
}

model OrgMembership {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  role      OrgRole
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

model VoucherCampaign {
  id                       String            @id @default(uuid())
  orgId                    String
  name                     String
  description              String?
  codePrefix               String?
  valueType                VoucherValueType
  valueAmount              Int
  currency                 String            @default("EUR")
  usageType                VoucherUsageType  @default(single)
  maxRedemptionsPerVoucher Int?
  validFrom                DateTime?
  validTo                  DateTime?
  minPurchaseAmount        Int?
  status                   B2BCampaignStatus @default(draft)
  restrictionsJson         Json?             @default("{}")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  org              Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vouchers         VoucherInstance[]
  orders           B2BOrder[]
  allowedPartners  CampaignAllowedPartner[]
  allowedProducts  CampaignAllowedProduct[]
  allowedLocations CampaignAllowedLocation[]

  @@index([orgId])
  @@index([status])
  @@index([validFrom, validTo])
}

model VoucherInstance {
  id                   String           @id @default(uuid())
  campaignId           String
  orgId                String
  code                 String           @unique
  codeHash             String?          @unique
  qrPayload            String?
  status               B2BVoucherStatus @default(created)
  issuedToType         IssuedToType?
  issuedToOrgId        String?
  issuedToEmail        String?
  initialValueAmount   Int
  remainingValueAmount Int?
  redeemedCount        Int              @default(0)
  activatedAt          DateTime?
  expiresAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  org         Organization        @relation("VoucherOrg", fields: [orgId], references: [id], onDelete: Cascade)
  campaign    VoucherCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  issuedToOrg Organization?       @relation("VoucherIssuedOrg", fields: [issuedToOrgId], references: [id], onDelete: SetNull)
  redemptions VoucherRedemption[]
  orderLinks  OrderVoucher[]

  @@index([orgId])
  @@index([campaignId])
  @@index([status])
  @@index([codeHash])
}

model CampaignAllowedPartner {
  id           String @id @default(uuid())
  campaignId   String
  partnerOrgId String

  campaign VoucherCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  partner  Organization    @relation(fields: [partnerOrgId], references: [id], onDelete: Cascade)

  @@unique([campaignId, partnerOrgId])
  @@index([partnerOrgId])
}

model CampaignAllowedProduct {
  id         String @id @default(uuid())
  campaignId String
  productId  String

  campaign VoucherCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([productId])
}

model CampaignAllowedLocation {
  id         String @id @default(uuid())
  campaignId String
  locationId String

  campaign VoucherCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, locationId])
  @@index([locationId])
}

model B2BOrder {
  id               String         @id @default(uuid())
  orgId            String
  campaignId       String
  quantity         Int
  unitPriceAmount  Int
  totalAmount      Int
  currency         String         @default("EUR")
  status           B2BOrderStatus @default(draft)
  paymentProvider  String?
  paymentReference String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign VoucherCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  invoice  B2BInvoice?
  vouchers OrderVoucher[]

  @@index([orgId])
  @@index([campaignId])
  @@index([status])
}

model B2BInvoice {
  id             String           @id @default(uuid())
  orderId        String           @unique
  invoiceNumber  String
  issuedAt       DateTime
  dueAt          DateTime?
  subtotalAmount Int
  vatAmount      Int
  totalAmount    Int
  status         B2BInvoiceStatus @default(issued)
  pdfUrl         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  order B2BOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([issuedAt])
}

model OrderVoucher {
  orderId   String
  voucherId String

  order   B2BOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  voucher VoucherInstance @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@id([orderId, voucherId])
  @@index([voucherId])
}

model VoucherRedemption {
  id             String              @id @default(uuid())
  voucherId      String
  partnerOrgId   String
  locationId     String?
  cashierUserId  String?
  amountRedeemed Int
  currency       String
  status         B2BRedemptionStatus @default(approved)
  idempotencyKey String
  metadata       Json?
  createdAt      DateTime            @default(now())

  voucher VoucherInstance @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  partner Organization    @relation("PartnerOrgRedemptions", fields: [partnerOrgId], references: [id], onDelete: Cascade)
  cashier User?           @relation("VoucherRedemptionCashier", fields: [cashierUserId], references: [id], onDelete: SetNull)

  @@unique([partnerOrgId, idempotencyKey])
  @@index([voucherId])
  @@index([partnerOrgId])
  @@index([createdAt])
}

model AuditEvent {
  id          String          @id @default(uuid())
  orgId       String
  actorUserId String?
  actorType   AuditActorType  @default(user)
  entityType  AuditEntityType
  entityId    String
  eventType   AuditEventType
  before      Json?
  after       Json?
  createdAt   DateTime        @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation("OrgAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model PartnerApiKey {
  id         String    @id @default(uuid())
  orgId      String
  label      String?
  keyHash    String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Merchant {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  country             String
  registryCode        String? // Company registration number
  vatNumber           String? // VAT/Tax ID
  taxResidenceCountry String?
  defaultCurrency     String    @default("USD")
  defaultLocale       String?   @default("en")
  dataResidency       String? // "EU" | "US" for data storage
  brandLogoUrl        String?
  brandColorsJson     Json?
  website             String?
  supportEmail        String?
  isActive            Boolean   @default(true) // Kill switch for launch mode
  featureFlags        Json? // Per-merchant feature flags
  invitedAt           DateTime? // Track manual invites
  onboardedAt         DateTime? // Track onboarding completion
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  members                   MerchantMember[]
  vouchers                  Voucher[]
  campaigns                 Campaign[]
  referrals                 Referral[]
  redemptions               Redemption[]
  creditLedgers             CreditLedger[]
  creditUsages              CreditUsage[]
  voucherPurchases          VoucherPurchase[]
  giftCards                 GiftCard[]
  giftCardPurchases         GiftCardPurchase[]
  subscription              MerchantSubscription?
  events                    Event[]
  tickets                   Ticket[]
  ticketPurchases           TicketPurchase[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  notificationSubscriptions NotificationSubscription[]
  pageBuilderPages          PageBuilderPage[]
  domainMappings            DomainMapping[]
  navigationLinks           NavigationLink[]
  sitePages                 SitePage[]
  products                  Product[]
  rentalItems               RentalItem[]
  checkoutIntents           CheckoutIntent[]
  webhookEndpoints          WebhookEndpoint[]
  userConsents              UserConsent[]              @relation("UserConsentMerchant")
  dataExportRequests        DataExportRequest[]        @relation("DataExportRequestMerchant")
  dataDeletionRequests      DataDeletionRequest[]      @relation("DataDeletionRequestMerchant")

  // Compliance relations
  vatExemptions   VatExemption[]   @relation("VatExemptionMerchant")
  invoices        Invoice[]        @relation("InvoiceMerchant")
  refundRequests  RefundRequest[]  @relation("RefundRequestMerchant")
  payoutRecords   PayoutRecord[]   @relation("PayoutRecordMerchant")

  // Smart Gift Feed relations
  giftProducts        GiftProduct[]            @relation("GiftProductMerchant")
  sponsoredPlacements SponsoredGiftPlacement[] @relation("SponsoredPlacementMerchant")

  @@index([isActive])
  @@index([country])
}

model MerchantMember {
  id         String   @id @default(cuid())
  merchantId String
  userId     String
  role       String // merchant_admin | merchant_staff
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([merchantId])
  @@index([userId])
}

model Campaign {
  id                   String    @id @default(cuid())
  merchantId           String
  name                 String
  description          String?
  type                 String // weekly | limited
  startDate            DateTime
  endDate              DateTime
  price                Int? // minor units, null = free
  discountRules        Json? // { type, value, currency }
  maxRedemptions       Int?
  maxPurchases         Int?
  terms                String?
  creditPercentage     Int? // % of purchase price as credit (basis points, e.g. 500 = 5%)
  promotedWeeklyEmail  Boolean   @default(false) // Paid weekly newsletter visibility
  promotedNotification Boolean   @default(false) // Paid notification visibility
  promotedUntil        DateTime? // Optional end date for promotion
  status               String    @default("draft") // draft | active | ended
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  merchant  Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  vouchers  Voucher[]
  purchases VoucherPurchase[]

  @@index([merchantId])
  @@index([status])
  @@index([startDate, endDate])
}

model Voucher {
  id                String    @id @default(cuid())
  merchantId        String
  campaignId        String?
  status            String    @default("draft") // draft | published | paused | ended
  type              String // percentage | fixed_amount | credit_amount
  value             Int // minor units for money, basis points for percentage
  currency          String
  validFrom         DateTime
  validTo           DateTime
  usageLimitTotal   Int?
  usageLimitPerUser Int?
  weeklyDropEnabled Boolean   @default(false)
  weeklyDropJson    Json?
  conditionsJson    Json?
  designJson        Json?
  codePrefix        String?
  isFlashSale       Boolean   @default(false)
  flashSaleEndsAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  merchant        Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  campaign        Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  referrals       Referral[]
  redemptions     Redemption[]
  purchases       VoucherPurchase[]
  waitlistEntries WaitlistEntry[]

  @@index([merchantId])
  @@index([campaignId])
  @@index([status])
  @@index([validFrom, validTo])
  @@index([isFlashSale])
}

model Referral {
  id             String   @id @default(cuid())
  voucherId      String
  merchantId     String
  referrerUserId String
  friendHash     String // hash of friend identifier (phone/email)
  status         String   @default("created") // created | opened | redeemed | expired | blocked
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  voucher    Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  referrer   User        @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  redemption Redemption?

  @@index([voucherId])
  @@index([merchantId])
  @@index([referrerUserId])
  @@index([friendHash])
  @@index([status])
}

model Redemption {
  id                    String    @id @default(cuid())
  voucherId             String
  merchantId            String
  referralId            String?   @unique
  redeemedByUserId      String?
  redeemedByStaffUserId String?
  method                String // online | in_store
  location              String? // optional location for redemption
  orderReference        String?
  amountBeforeDiscount  Int // minor units
  discountApplied       Int // minor units
  currency              String
  confirmedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  voucher         Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  merchant        Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  referral        Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  redeemedBy      User?     @relation("RedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  redeemedByStaff User?     @relation("RedeemedByStaff", fields: [redeemedByStaffUserId], references: [id], onDelete: SetNull)

  @@index([voucherId])
  @@index([merchantId])
  @@index([referralId])
  @@index([confirmedAt])
}

model VoucherPurchase {
  id                String   @id @default(cuid())
  voucherId         String?
  campaignId        String?
  merchantId        String
  userId            String
  stripeSessionId   String?
  amount            Int // minor units
  platformFeeAmount Int? // 5% platform fee in minor units
  currency          String
  status            String   @default("pending") // pending | paid | failed | refunded
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  voucher  Voucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([userId])
  @@index([status])
  @@index([stripeSessionId])
}

model CreditLedger {
  id         String    @id @default(cuid())
  merchantId String
  userId     String
  amount     Int // minor units
  currency   String
  status     String    @default("locked") // locked | available | used | expired | reversed
  source     String // referral_redemption | manual_adjustment
  sourceId   String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model CreditUsage {
  id              String   @id @default(cuid())
  merchantId      String
  userId          String
  creditLedgerIds String[] // array of credit ledger IDs used
  amountUsed      Int // minor units
  orderReference  String?
  createdAt       DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([userId])
}

model Event {
  id              String    @id @default(cuid())
  merchantId      String
  name            String
  description     String?
  type            String // festival | internal | concert | workshop | other
  eventDate       DateTime
  eventEndDate    DateTime?
  location        String?
  locationAddress String?
  maxCapacity     Int // Maximum number of tickets/seats
  price           Int // minor units, 0 = free
  currency        String    @default("USD")
  ticketTypesJson Json? // [{ name, price, capacity }] for different ticket tiers
  terms           String?
  status          String    @default("draft") // draft | published | sold_out | cancelled | ended
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  merchant  Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
  purchases TicketPurchase[]

  @@index([merchantId])
  @@index([status])
  @@index([eventDate])
}

model Ticket {
  id           String    @id @default(cuid())
  eventId      String
  merchantId   String
  ticketType   String? // VIP, Standard, Early Bird, etc.
  ticketNumber String    @unique // Human-readable ticket number
  qrToken      String    @unique // QR code token
  status       String    @default("available") // available | sold | used | cancelled | refunded
  purchasedAt  DateTime?
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  purchase TicketPurchase?

  @@index([eventId])
  @@index([merchantId])
  @@index([status])
  @@index([qrToken])
  @@index([ticketNumber])
}

model TicketPurchase {
  id              String   @id @default(cuid())
  ticketId        String   @unique
  eventId         String
  merchantId      String
  userId          String
  stripeSessionId String?
  amount          Int // minor units
  currency        String

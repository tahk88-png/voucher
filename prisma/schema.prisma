enum GiftFeedModuleType {
  SEASONAL
  TRENDING
  AI_CURATED
  PARTNER
  CORPORATE
  LAST_MINUTE
}

enum GiftInteractionType {
  VIEW
  SAVE
  SHARE
  ADD_TO_CART
  PURCHASE
  CLICK_AFFILIATE
}

model GiftCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  color     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products GiftProduct[]

  @@index([isActive, sortOrder])
}

model GiftOccasion {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  seasonalityWeight Float    @default(1.0)
  activeMonths      Int[]    @default([]) // 1-12, empty = year-round
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  products GiftProductOccasion[]

  @@index([isActive])
}

model GiftPersona {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  tags      String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products GiftProductPersona[]

  @@index([isActive])
}

model GiftProduct {
  id              String   @id @default(cuid())
  merchantId      String
  title           String
  description     String   @db.Text
  priceCents      Int
  currency        String   @default("EUR")
  mediaUrl        String?
  mediaUrls       String[] @default([])
  stock           Int? // null = unlimited
  categoryId      String
  tags            String[] @default([])
  affiliateUrl    String?
  isFeatured      Boolean  @default(false)
  engagementScore Float    @default(0)
  viewCount       Int      @default(0)
  purchaseCount   Int      @default(0)
  conversionRate  Float    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchant     Merchant              @relation("GiftProductMerchant", fields: [merchantId], references: [id], onDelete: Cascade)
  category     GiftCategory          @relation(fields: [categoryId], references: [id])
  occasions    GiftProductOccasion[]
  personas     GiftProductPersona[]
  feedItems    GiftFeedItem[]
  interactions UserGiftInteraction[]

  @@index([merchantId])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isActive, engagementScore])
  @@index([priceCents])
}

model GiftProductOccasion {
  id         String @id @default(cuid())
  productId  String
  occasionId String

  product  GiftProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion GiftOccasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@unique([productId, occasionId])
}

model GiftProductPersona {
  id        String @id @default(cuid())
  productId String
  personaId String

  product GiftProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  persona GiftPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([productId, personaId])
}

model GiftFeedModule {

{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping /api/admin/ops/metrics/prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "title": "Voucher Platform — Ops",
  "description": "Operational overview sourced from /api/admin/ops/metrics/prometheus. Panels map 1:1 to metric families defined in lib/metrics.ts and lib/ops-gauges.ts.",
  "tags": ["voucher-platform", "ops"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "${DS_PROMETHEUS}" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "System",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "description": "process_uptime_seconds — resets on deploy / cold start.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        { "expr": "process_uptime_seconds", "refId": "A", "legendFormat": "uptime" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory — RSS vs heap used",
      "description": "Resident set size and V8 heap usage. A growing gap between them usually points to native buffers or Sharp/PDF work.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 10, "x": 4, "y": 1 },
      "targets": [
        { "expr": "process_memory_rss_bytes", "refId": "A", "legendFormat": "rss" },
        { "expr": "process_memory_heap_used_bytes", "refId": "B", "legendFormat": "heap_used" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP request rate by status",
      "description": "rate(http_requests_total[5m]) stacked by response status. A sudden 5xx wedge is your loudest alert signal.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 10, "x": 14, "y": 1 },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 25, "stacking": { "mode": "normal" } } },
        "overrides": []
      }
    },

    {
      "id": 10,
      "type": "row",
      "title": "HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Top paths by request rate",
      "description": "Top-10 normalized paths. Path templates come from normalizePath() in lib/metrics.ts — raw IDs are collapsed to :id.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "topk(10, sum by (path) (rate(http_requests_total[5m])))",
          "refId": "A",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP p50 / p95 / p99 latency",
      "description": "Client-observed request duration in ms. Percentiles come from the summary-style histogram exposed by getMetricsPrometheus().",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        { "expr": "http_request_duration_ms{quantile=\"0.5\"}", "refId": "A", "legendFormat": "p50" },
        { "expr": "http_request_duration_ms{quantile=\"0.95\"}", "refId": "B", "legendFormat": "p95" },
        { "expr": "http_request_duration_ms{quantile=\"0.99\"}", "refId": "C", "legendFormat": "p99" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 } },
        "overrides": []
      }
    },

    {
      "id": 20,
      "type": "row",
      "title": "Database + cache",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "DB query rate by model",
      "description": "rate(db_queries_total[5m]) split by Prisma model. Unexpected spikes on a single model usually mean a missing index or an N+1.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "sum by (model) (rate(db_queries_total[5m]))",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "rate(cache_hits_total) / (rate(cache_hits_total) + rate(cache_misses_total)). Split by key bucket (not raw key) — buckets come from cacheKeyBucket() in lib/metrics.ts.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "expr": "sum by (key) (rate(cache_hits_total[5m])) / clamp_min(sum by (key) (rate(cache_hits_total[5m])) + sum by (key) (rate(cache_misses_total[5m])), 0.0001)",
          "refId": "A",
          "legendFormat": "{{key}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 } },
        "overrides": []
      }
    },

    {
      "id": 30,
      "type": "row",
      "title": "Safety rails",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Rate-limit rejections by scope",
      "description": "rate(rate_limit_rejections_total[5m]) by scope + backend. Spikes on 'auth_*' scopes are usually credential-stuffing; spikes on 'api_public' suggest scraping.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "targets": [
        {
          "expr": "sum by (scope, backend) (rate(rate_limit_rejections_total[5m]))",
          "refId": "A",
          "legendFormat": "{{scope}} ({{backend}})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15 } },
        "overrides": []
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Circuit breaker transitions",
      "description": "rate(circuit_breaker_transitions_total[5m]) by name + target state. A sustained non-zero on 'to=open' is the canonical 'provider is down' signal.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "targets": [
        {
          "expr": "sum by (name, to) (rate(circuit_breaker_transitions_total[5m]))",
          "refId": "A",
          "legendFormat": "{{name}} → {{to}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      }
    },

    {
      "id": 40,
      "type": "row",
      "title": "Backlogs (live gauges)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Email queue depth by status",
      "description": "voucher_email_queue_depth — live DB gauge of EmailJob rows in queued/processing/failed. Sustained growth on 'queued' means the cron dispatcher is falling behind.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [
        { "expr": "voucher_email_queue_depth", "refId": "A", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 10000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Payout backlog by status",
      "description": "voucher_payout_backlog_count — PayoutRecord rows in pending/processing, plus active PayoutHold as 'held'. The 'held' series should only grow during investigation windows; watch for it sticking.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "targets": [
        { "expr": "voucher_payout_backlog_count", "refId": "A", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      }
    }
  ]
}

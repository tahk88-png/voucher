{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/credit-expiry-warnings",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/voucher-expiry-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/campaign-ending-notifications",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/weekly-campaign-digest",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/flash-sale-alerts",
      "schedule": "*/30 * * * *"
    }
  ],
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}

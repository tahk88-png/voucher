{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/credit-expiry-warnings",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/voucher-expiry-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/campaign-ending-notifications",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/weekly-campaign-digest",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/flash-sale-alerts",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/email-queue",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/email-stale-locks",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/email-stats",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/streaks-badges",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/loyalty-tiers",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/auto-expire",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/price-alerts",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/scheduled-reports",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/smart-notifications",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/refresh-currency-rates",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/bnpl-installments",
      "schedule": "0 4 * * *"
    }
  ],
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}

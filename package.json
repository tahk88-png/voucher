{
  "name": "voucher-platform",
  "version": "1.0.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "clean": "node -e \"const fs=require('fs');try{fs.rmSync('.next',{recursive:true,force:true})}catch(e){};try{fs.rmSync('.next/cache',{recursive:true,force:true})}catch(e){}\"",
    "dev:all": "npm run dev:full",
    "dev:full": "powershell -ExecutionPolicy Bypass -File scripts/dev-full.ps1",
    "build": "node scripts/build.cjs",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:check": "powershell -ExecutionPolicy Bypass -File scripts/check-docker.ps1",
    "db:wait": "powershell -ExecutionPolicy Bypass -File scripts/wait-for-db.ps1",
    "db:setup": "npm run db:check && npm run docker:up && timeout /t 5 /nobreak >nul 2>&1 || node -e \"const d=Date.now(); while(Date.now()-d<5000);\" && npm run db:wait && npm run db:push && npm run db:seed",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:ensure-test-user": "tsx prisma/ensure-test-user.ts",
    "db:reset": "npm run docker:down && npm run docker:up && timeout /t 5 /nobreak >nul 2>&1 || node -e \"const d=Date.now(); while(Date.now()-d<5000);\" && npm run db:wait && npm run db:push && npm run db:seed",
    "db:studio": "prisma studio",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "verify:setup": "tsx scripts/verify-mvp-setup.ts",
    "test:launch-mode": "tsx scripts/test-launch-mode.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "validate:env": "tsx scripts/validate-env.ts"
  },
